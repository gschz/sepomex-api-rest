{
   "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
   "vcs": {
      "enabled": false,
      "clientKind": "git",
      "useIgnoreFile": false
   },
   "files": {
      "ignoreUnknown": false,
      "ignore": ["dist/**", "node_modules/**"]
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineWidth": 110
   },
   "organizeImports": {
      "enabled": true
   },
   "linter": {
      "enabled": true,
      "rules": {
         "recommended": true,
         "style": {
            "noNonNullAssertion": "warn",
            "useConsistentArrayType": "warn"
         },
         "suspicious": {
            "noExplicitAny": "warn"
         }
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "single",
         "trailingCommas": "all"
      },
      "parser": {
         "unsafeParameterDecoratorsEnabled": true
      }
   }
}
