{
   "name": "sepomex-api-rest",
   "version": "2.0.0",
   "description": "API REST para la base de datos de códigos postales de México (SEPOMEX)",
   "author": "Gera Schz",
   "license": "MIT",
   "main": "dist/app.js",
   "scripts": {
      "start": "bun dist/app.js",
      "dev": "bun --watch src/app.ts",
      "test": "bun test",
      "build": "bun build --target node ./src/app.ts --outfile=dist/app.js && bun run copy-files",
      "copy-files": "copyfiles -u 1 src/**/*.{json,sql} dist/",
      "lint": "biome check .",
      "lint:fix": "biome check --fix --unsafe .",
      "format": "biome format .",
      "format:fix": "biome format --write .",
      "clean": "rimraf dist"
   },
   "keywords": ["sepomex", "api", "rest"],
   "dependencies": {
      "@elysiajs/cors": "^1.4.2",
      "@elysiajs/fn": "^0.6.1",
      "@elysiajs/openapi": "^1.4.15",
      "elysia": "^1.4.29",
      "elysia-helmet": "^3.1.0",
      "elysia-rate-limit": "^4.3.0",
      "pg": "^8.23.0"
   },
   "devDependencies": {
      "@biomejs/biome": "1.9.4",
      "@types/bun": "^1.3.14",
      "@types/node": "^20.17.50",
      "@types/pg": "^8.21.0",
      "copyfiles": "^2.4.1",
      "rimraf": "^5.0.10",
      "typescript": "^5.8.3"
   },
   "engines": {
      "bun": ">=1.2.10"
   }
}
